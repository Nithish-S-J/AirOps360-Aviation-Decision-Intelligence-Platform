    )
VAR Flights =
    CALCULATE (
        [Total Flights],
        Period
    )
RETURN
    DIVIDE ( DivertedFlights, Flights )


// -----------------------------------------------------------------------------
// RUNNING TOTALS
// -----------------------------------------------------------------------------

Running Total Flights =
VAR CurrentDate =
    MAX ( dim_date[flight_date] )
RETURN
    CALCULATE (
        [Total Flights],
        FILTER (
            ALLSELECTED ( dim_date[flight_date] ),
            dim_date[flight_date] <= CurrentDate
        )
    )


Running Total Passengers =
VAR CurrentDate =
    MAX ( dim_date[flight_date] )
RETURN
    CALCULATE (
        [Total Passengers],
        FILTER (
            ALLSELECTED ( dim_date[flight_date] ),
            dim_date[flight_date] <= CurrentDate
        )
    )


Running Total Cancelled Flights =
VAR CurrentDate =
    MAX ( dim_date[flight_date] )
RETURN
    CALCULATE (
        [Total Cancelled Flights],
        FILTER (
            ALLSELECTED ( dim_date[flight_date] ),
            dim_date[flight_date] <= CurrentDate
        )
    )


// -----------------------------------------------------------------------------
// TREND & VARIANCE ANALYSIS
// -----------------------------------------------------------------------------

Daily Flights vs 7-Day Average =
[Total Flights] - [Rolling 7-Day Avg Flights]


Daily Flights Variance % =
VAR RollingAverage =
    [Rolling 7-Day Avg Flights]
RETURN
    DIVIDE (
        [Total Flights] - RollingAverage,
        RollingAverage
    )


// -----------------------------------------------------------------------------
// OPERATIONAL TREND CLASSIFICATION
// -----------------------------------------------------------------------------

Operational Trend Status =
VAR CurrentFlights =
    [Total Flights]
VAR RollingAverage =
    [Rolling 7-Day Avg Flights]
VAR VariancePct =
    DIVIDE (
        CurrentFlights - RollingAverage,
        RollingAverage
    )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( RollingAverage ), BLANK (),
        VariancePct >= 0.10, "Above Trend",
        VariancePct <= -0.10, "Below Trend",
        "Stable"
    )
