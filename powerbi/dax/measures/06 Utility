// =============================================================================
// 06 — VISUAL PERFORMANCE INDICATORS
// =============================================================================

Flight Trend Indicator =
VAR Change =
    [Daily Flight Change %]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Change ), BLANK (),
        Change > 0.05, "▲ Strong Increase",
        Change > 0, "▲ Increase",
        Change < -0.05, "▼ Strong Decline",
        Change < 0, "▼ Decline",
        "● Stable"
    )


Reliability Indicator =
VAR Score =
    [Operational Reliability Score]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Score ), BLANK (),
        Score >= 85, "● Strong",
        Score >= 70, "● Stable",
        Score >= 55, "▲ Watch",
        "▲ Action Required"
    )


Delay Benchmark Indicator =
VAR Difference =
    [Arrival Delay vs Network]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Difference ), BLANK (),
        Difference <= -5, "▲ Significantly Better",
        Difference < 0, "▲ Better than Network",
        Difference <= 5, "● Near Network",
        "▼ Worse than Network"
    )


// =============================================================================
// 07 — DATA COVERAGE & FRESHNESS
// =============================================================================

Data Coverage Label =
VAR MinDate =
    CALCULATE (
        MIN ( dim_date[flight_date] ),
        ALL ( dim_date )
    )
VAR MaxDate =
    CALCULATE (
        MAX ( dim_date[flight_date] ),
        ALL ( dim_date )
    )
RETURN
    "Data Coverage: "
        & FORMAT ( MinDate, "dd MMM yyyy" )
        & " - "
        & FORMAT ( MaxDate, "dd MMM yyyy" )


Last Available Data Date =
CALCULATE (
    MAX ( dim_date[flight_date] ),
    ALL ( dim_date )
)


Last Available Data Label =
"Latest Data: "
    & FORMAT (
        [Last Available Data Date],
        "dd MMM yyyy"
    )
