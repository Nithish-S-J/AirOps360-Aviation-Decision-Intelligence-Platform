/*
===============================================================================
 AirOps360 — Utility Measures
===============================================================================

 Semantic Model : sm_airops360
 Measure Table  : All_Measures
 Display Folder : 06 Utility

 Purpose:
 Provides presentation and report-context utilities for the AirOps360
 Power BI experience, including dynamic filter context, report titles,
 executive KPI labels, trend indicators, and data coverage metadata.

===============================================================================
*/


// =============================================================================
// 01 — SELECTED FILTER CONTEXT
// =============================================================================

Selected Airline =
VAR Selection =
    SELECTEDVALUE ( dim_airline[airline_name] )
RETURN
    COALESCE ( Selection, "All Airlines" )


Selected Airport =
VAR Selection =
    SELECTEDVALUE ( dim_airport[airport_name] )
RETURN
    COALESCE ( Selection, "All Airports" )


Selected Route =
VAR Origin =
    SELECTEDVALUE ( dim_route[origin_airport] )
VAR Destination =
    SELECTEDVALUE ( dim_route[destination_airport] )
RETURN
    IF (
        NOT ISBLANK ( Origin )
            && NOT ISBLANK ( Destination ),
        Origin & " → " & Destination,
        "All Routes"
    )


Selected Date =
VAR MinDate =
    MIN ( dim_date[flight_date] )
VAR MaxDate =
    MAX ( dim_date[flight_date] )
RETURN
    IF (
        MinDate = MaxDate,
        FORMAT ( MinDate, "dd MMM yyyy" ),
        FORMAT ( MinDate, "dd MMM yyyy" )
            & " - "
            & FORMAT ( MaxDate, "dd MMM yyyy" )
    )


// =============================================================================
// 02 — ACTIVE FILTER CONTEXT
// =============================================================================

Active Airline Filter =
VAR CountSelected =
    COUNTROWS (
        ALLSELECTED ( dim_airline[airline_name] )
    )
VAR CountAll =
    COUNTROWS (
        ALL ( dim_airline[airline_name] )
    )
RETURN
    IF (
        CountSelected < CountAll,
        FORMAT ( CountSelected, "#,0" )
            & " Airline(s) Selected",
        "All Airlines"
    )


Active Airport Filter =
VAR CountSelected =
    COUNTROWS (
        ALLSELECTED ( dim_airport[airport_name] )
    )
VAR CountAll =
    COUNTROWS (
        ALL ( dim_airport[airport_name] )
    )
RETURN
    IF (
        CountSelected < CountAll,
        FORMAT ( CountSelected, "#,0" )
            & " Airport(s) Selected",
        "All Airports"
    )


Active Route Filter =
VAR SelectedRoutes =
    COUNTROWS (
        ALLSELECTED ( dim_route[route_key] )
    )
VAR AllRoutes =
    COUNTROWS (
        ALL ( dim_route[route_key] )
    )
RETURN
    IF (
        SelectedRoutes < AllRoutes,
        FORMAT ( SelectedRoutes, "#,0" )
            & " Route(s) Selected",
        "All Routes"
    )


